aws_region    = "ap-south-1"
project_name  = "ha-web"
instance_type = "t3.micro"

asg_min_size         = 2
asg_desired_capacity = 2
asg_max_size         = 6
cpu_target_percent   = 50

alert_email = "you@example.com"

# Optional - only if you own a domain in Route 53
domain_name = ""
subdomain   = "app"
